# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas el archivo .env a GitHub — ya está en .gitignore.

# ---------------------------------------------------------------------------
# Telegram — notificaciones
# ---------------------------------------------------------------------------

# Token del bot de Telegram (obtenlo con @BotFather)
TELEGRAM_TOKEN=your-bot-token-here

# ID del chat o canal donde se envían las notificaciones
# Para bots privados: ID positivo (ej: 123456789)
# Para grupos/canales: ID negativo (ej: -100123456789)
TELEGRAM_CHAT_ID=your-chat-id-here

# ---------------------------------------------------------------------------
# URLs de las fuentes de empleo
# Cambia solo si usas un proxy, mirror, o entorno de pruebas.
# Si no defines estas variables, se usan los valores por defecto.
# ---------------------------------------------------------------------------

LINKEDIN_BASE_URL=<<URL>>
ELEMPLEO_BASE_URL=<<URL>>
COMPUTRABAJO_BASE_URL=<<URL>>
